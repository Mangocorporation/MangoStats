<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>com.mangocorp.mangostats</string>
<key>CFBundleName</key><string>MangoStats</string>
<key>CFBundleDisplayName</key><string>MangoStats</string>
<key>CFBundleExecutable</key><string>MangoStats</string>
